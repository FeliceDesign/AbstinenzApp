<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Privacy by design: no INTERNET permission is declared here, so release
         builds cannot access the network. The permission in the debug manifest
         is dev-tooling only (hot reload) and is not merged into release. -->
    <!-- The only runtime permission the app asks for: local milestone / check-in
         notifications (Android 13+). No exact-alarm permission — milestone
         notifications are scheduled inexactly, which is fine for the use case. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Optional in-app biometric/passcode lock (local_auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <application
        android:label="Unbound"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Home-screen widgets. Each is a plain RemoteViews AppWidget; tapping
             launches MainActivity (the urge widget deep-links via unbound://urge).
             No extra permissions — the widgets read only locally-stored data. -->
        <receiver
            android:name=".TimeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_time_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_time_info" />
        </receiver>
        <receiver
            android:name=".MoneyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_money_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_money_info" />
        </receiver>
        <receiver
            android:name=".UrgeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_urge_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_urge_info" />
        </receiver>
        <receiver
            android:name=".DashboardWidgetProvider"
            android:exported="true"
            android:label="@string/widget_dashboard_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dashboard_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets the emergency-contact technique dial a number (url_launcher
             tel:). This is a query only — it grants no network permission. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
