<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_cream"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/dash_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:textColor="#3A322B"
        android:textSize="15sp"
        android:text="Unbound" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dash_time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_blue"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/dash_time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:textColor="#FFFDF9"
                android:textSize="24sp"
                android:text="–" />

            <TextView
                android:id="@+id/dash_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#E8F5FC"
                android:textSize="11sp"
                android:text="days" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dash_money"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip_gold"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/dash_money_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:textColor="#3A322B"
                android:textSize="20sp"
                android:text="–" />

            <TextView
                android:id="@+id/dash_money_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#8A7F73"
                android:textSize="11sp"
                android:text="Saved" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dash_urge_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_chip_berry"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="⚡" />

        <TextView
            android:id="@+id/dash_urge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFDF9"
            android:textSize="14sp"
            android:text="Urge?" />
    </LinearLayout>
</LinearLayout>
